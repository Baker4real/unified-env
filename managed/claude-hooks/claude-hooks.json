{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "D:\\Codex\\tools\\bin\\node.exe",
          "args": [
            "D:\\agents\\projects\\统一环境\\managed\\claude-hooks\\claude-session-settings-check.mjs"
          ],
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "PowerShell|Bash|mcp__terminal__run_in_terminal",
      "hooks": [
        {
          "type": "command",
          "command": "D:\\Codex\\tools\\bin\\node.exe",
          "args": [
            "D:\\agents\\projects\\统一环境\\managed\\claude-hooks\\claude-pretool-guard.mjs"
          ],
          "timeout": 10,
          "onFailure": "continue"
        },
        {
          "type": "command",
          "command": "D:\\Codex\\tools\\bin\\node.exe",
          "args": [
            "D:\\agents\\projects\\统一环境\\managed\\claude-hooks\\claude-public-push-guard.mjs"
          ],
          "timeout": 30,
          "onFailure": "continue"
        }
      ]
    },
    {
      "matcher": "Write|Edit",
      "hooks": [
        {
          "type": "command",
          "command": "D:\\Codex\\tools\\bin\\node.exe",
          "args": [
            "D:\\agents\\projects\\统一环境\\managed\\claude-hooks\\claude-pretool-guard.mjs"
          ],
          "timeout": 10,
          "onFailure": "continue"
        }
      ]
    },
    {
      "matcher": "Grep|Glob",
      "hooks": [
        {
          "type": "command",
          "command": "D:\\Codex\\tools\\bin\\node.exe",
          "args": [
            "D:\\agents\\projects\\统一环境\\managed\\claude-hooks\\claude-pretool-guard.mjs"
          ],
          "timeout": 10,
          "onFailure": "continue"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "D:\\Codex\\tools\\bin\\node.exe",
          "args": [
            "D:\\agents\\projects\\统一环境\\managed\\claude-hooks\\claude-stop-handoff-lint.mjs"
          ],
          "timeout": 10
        }
      ]
    }
  ]
}
