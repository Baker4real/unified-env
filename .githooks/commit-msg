#!/bin/sh
# 按要提交的 index 检查：整棵树过一遍边界校验（同 Validate-ModuleBoundaries.cjs --rev），有违规就拒绝提交；提交说明的
# scope 是模块 id（含 shared）时，暂存改动里还要至少有一个文件归这个模块，scope 不是模块 id 时不查这一项。
# 归属按暂存区里的 modules/manifest.json 判断。新克隆先运行 git config core.hooksPath .githooks。
node "$(dirname "$0")/../scripts/Validate-ModuleBoundaries.cjs" --commit-msg "$1" || exit
