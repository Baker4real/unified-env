diff --git a/internal/gui/library_scoped.go b/internal/gui/library_scoped.go
new file mode 100644
index 0000000..27ca1e2
--- /dev/null
+++ b/internal/gui/library_scoped.go
@@ -0,0 +1,97 @@
+package gui
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/yetone/magpie/internal/library"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// ServeScopedLibrary exposes the opt-in writer on loopback only. It runs
+// without the Web UI's gateway, updater, startup and view reconciliation.
+func ServeScopedLibrary(addr string) error {
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil || host != "127.0.0.1" || port == "" || port == "0" {
+		return errors.New("scoped Library needs 127.0.0.1 and a fixed port")
+	}
+	key := os.Getenv("MAGPIE_WEB_KEY")
+	if err := CheckWebKey(key); err != nil {
+		return err
+	}
+	srv := &http.Server{
+		Addr:              addr,
+		Handler:           webHandler(port, key, 0, nil, scopedLibraryHandler()),
+		ReadHeaderTimeout: 10 * time.Second,
+	}
+	return srv.ListenAndServe()
+}
+
+func scopedLibraryHandler() http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /api/library/scoped", func(rw http.ResponseWriter, r *http.Request) {
+		writeJSON(rw, struct {
+			Version int    `json:"scopeVersion"`
+			State   string `json:"statePath"`
+		}{1, filepath.Join(settings.Dir(), "library.json")})
+	})
+	mux.HandleFunc("POST /api/library/scoped/{kind}/{action}", func(rw http.ResponseWriter, r *http.Request) {
+		var in struct {
+			Name, Source         string
+			Names, Paths, Agents []string
+			On                   *bool
+		}
+		dec := json.NewDecoder(http.MaxBytesReader(rw, r.Body, 64*1024))
+		dec.DisallowUnknownFields()
+		if err := dec.Decode(&in); err != nil || dec.Decode(new(any)) != io.EOF {
+			http.Error(rw, "invalid scoped Library request", http.StatusBadRequest)
+			return
+		}
+		var res *library.Result
+		var err error
+		switch r.PathValue("kind") + "/" + r.PathValue("action") {
+		case "skills/probe":
+			if !filepath.IsAbs(in.Source) {
+				http.Error(rw, "scoped probe needs an absolute folder", http.StatusBadRequest)
+				return
+			}
+			p, err := library.ProbeSkills(in.Source)
+			if err != nil {
+				fail(rw, err)
+				return
+			}
+			writeJSON(rw, p)
+			return
+		case "skills/install":
+			res, err = library.InstallFolderSkillsScoped(in.Source, in.Paths, in.Agents)
+		case "skills/agents":
+			res, err = library.SetSkillAgentsScoped(in.Name, in.Agents)
+		case "servers/agents-all", "servers/agents-some":
+			if in.On == nil || (r.PathValue("action") == "agents-some") != (len(in.Names) > 0) {
+				http.Error(rw, "select servers explicitly or use agents-all, and specify on", http.StatusBadRequest)
+				return
+			}
+			if r.PathValue("action") == "agents-all" {
+				in.Names = nil
+			}
+			res, err = library.SetServersAgentsScoped(in.Names, in.Agents, *in.On)
+		default:
+			http.NotFound(rw, r)
+			return
+		}
+		if err != nil {
+			fail(rw, err)
+			return
+		}
+		writeJSON(rw, struct {
+			Result *library.Result `json:"result"`
+		}{res})
+	})
+	return mux
+}
