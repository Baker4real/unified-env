+package gui
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/library"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+func scopedWrite(t *testing.T, path, data string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(data), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func scopedRead(t *testing.T, path string) []byte {
+	t.Helper()
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+func scopedFixture(t *testing.T) (home, agy, desktop, state string) {
+	t.Helper()
+	home = sandboxHome(t)
+	local, roaming := filepath.Join(home, "AppData", "Local"), filepath.Join(home, "AppData", "Roaming")
+	t.Setenv("LOCALAPPDATA", local)
+	t.Setenv("APPDATA", roaming)
+	var desktopDir string
+	switch runtime.GOOS {
+	case "windows":
+		scopedWrite(t, filepath.Join(local, "AnthropicClaude", "claude.exe"), "detection marker, never executed")
+		desktopDir = filepath.Join(local, "Claude-3p")
+	case "darwin":
+		desktopDir = filepath.Join(home, "Library", "Application Support", "Claude-3p")
+	default:
+		desktopDir = filepath.Join(home, ".config", "Claude-3p")
+	}
+	scopedWrite(t, filepath.Join(home, ".gemini", "antigravity", "agyhub_summaries_proto.pb"), "fixture")
+	agy = filepath.Join(home, ".gemini", "config", "mcp_config.json")
+	desktop = filepath.Join(desktopDir, "claude_desktop_config.json")
+	scopedWrite(t, agy, "{ \"mcpServers\" : {} }\r\n")
+	scopedWrite(t, desktop, "{\r\n  \"mcpServers\": {}, \"existingPreference\": true\r\n}\r\n")
+	return home, agy, desktop, filepath.Join(settings.Dir(), "library.json")
+}
+
+func scopedPost(h http.Handler, path, body string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest("POST", path, strings.NewReader(body)))
+	return rec
+}
+
+func TestLibraryScopedMCPBytes(t *testing.T) {
+	_, agy, desktop, state := scopedFixture(t)
+	scopedWrite(t, state, `{"mcp":[{"name":"fixture-server","transport":"stdio","command":"fixture-stdio","agents":["antigravity","claude-desktop"]}]}`)
+	beforeAgy, beforeDesktop := scopedRead(t, agy), scopedRead(t, desktop)
+	rec := scopedPost(scopedLibraryHandler(), "/api/library/scoped/servers/agents-some",
+		`{"names":["fixture-server"],"agents":["antigravity"],"on":true}`)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("write status %d, body %s", rec.Code, rec.Body)
+	}
+	if got := scopedRead(t, agy); bytes.Equal(beforeAgy, got) || !bytes.Contains(got, []byte("fixture-stdio")) {
+		t.Fatalf("authorized Antigravity configuration did not receive pending MCP entry: %q", got)
+	}
+	if got := scopedRead(t, desktop); !bytes.Equal(beforeDesktop, got) {
+		t.Fatalf("unselected Claude Desktop configuration changed bytes: %q -> %q", beforeDesktop, got)
+	}
+	var out struct{ Result library.Result }
+	if err := json.Unmarshal(rec.Body.Bytes(), &out); err != nil {
+		t.Fatal(err)
+	}
+	if len(out.Result.Changed) != 1 || out.Result.Changed[0] != "antigravity" || len(out.Result.Problems) != 0 {
+		t.Fatalf("MCP writer result: %+v", out.Result)
+	}
+	// Prove the untouched file actually had work pending: explicitly
+	// authorizing Desktop now puts the same server in its config.
+	afterAgy := scopedRead(t, agy)
+	rec = scopedPost(scopedLibraryHandler(), "/api/library/scoped/servers/agents-all",
+		`{"agents":["claude-desktop"],"on":true}`)
+	if got := scopedRead(t, desktop); rec.Code != http.StatusOK || bytes.Equal(beforeDesktop, got) || !bytes.Contains(got, []byte("fixture-stdio")) {
+		t.Fatalf("Desktop had no provable pending write: status %d, config %q, body %s", rec.Code, got, rec.Body)
+	}
+	if !bytes.Equal(afterAgy, scopedRead(t, agy)) {
+		t.Fatal("Desktop authorization changed Antigravity bytes")
+	}
+}
+
+func TestLibraryScopedSkillBytes(t *testing.T) {
+	for _, action := range []string{"install", "agents"} {
+		t.Run(action, func(t *testing.T) {
+			home, agy, desktop, state := scopedFixture(t)
+			const payload = "---\nname: fixture-skill\ndescription: Fixture\n---\nFixture skill content.\n"
+			const pending = "---\nname: desktop-pending\ndescription: Fixture\n---\nPending desktop copy.\n"
+			skillDir := filepath.Join(filepath.Dir(state), "library", "skills")
+			scopedWrite(t, filepath.Join(skillDir, "desktop-pending", "SKILL.md"), pending)
+			manifest := filepath.Join(filepath.Dir(desktop), "local-agent-mode-sessions", "skills-plugin", "org", "account", "manifest.json")
+			scopedWrite(t, manifest, "{\r\n  \"skills\": []\r\n}\r\n")
+			beforeManifest, beforeAgy, beforeDesktop := scopedRead(t, manifest), scopedRead(t, agy), scopedRead(t, desktop)
+			const other = `{"name":"desktop-pending","agents":["claude-desktop"]}`
+			in := map[string]any{"agents": []string{"antigravity"}}
+			if action == "install" {
+				source := filepath.Join(home, "fixture-source")
+				scopedWrite(t, filepath.Join(source, "SKILL.md"), payload)
+				scopedWrite(t, state, `{"skills":[`+other+`]}`)
+				in["source"], in["paths"] = source, []string{""}
+			} else {
+				scopedWrite(t, filepath.Join(skillDir, "fixture-skill", "SKILL.md"), payload)
+				scopedWrite(t, state, `{"skills":[`+other+`,{"name":"fixture-skill","agents":[]}]}`)
+				in["name"] = "fixture-skill"
+			}
+			b, err := json.Marshal(in)
+			if err != nil {
+				t.Fatal(err)
+			}
+			rec := scopedPost(scopedLibraryHandler(), "/api/library/scoped/skills/"+action, string(b))
+			if rec.Code != http.StatusOK {
+				t.Fatalf("skill write: %d %s", rec.Code, rec.Body)
+			}
+			p := filepath.Join(filepath.Dir(agy), "skills", "fixture-skill", "SKILL.md")
+			if got := scopedRead(t, p); !bytes.Equal(got, []byte(payload)) {
+				t.Fatalf("wrong authorized skill bytes: %q", got)
+			}
+			if !bytes.Equal(beforeManifest, scopedRead(t, manifest)) || !bytes.Equal(beforeDesktop, scopedRead(t, desktop)) || !bytes.Equal(beforeAgy, scopedRead(t, agy)) {
+				t.Fatal("scoped skill action changed Desktop's manifest or either MCP config")
+			}
+			rec = scopedPost(scopedLibraryHandler(), "/api/library/scoped/skills/agents",
+				`{"name":"desktop-pending","agents":["claude-desktop"]}`)
+			if rec.Code != http.StatusOK || bytes.Equal(beforeManifest, scopedRead(t, manifest)) {
+				t.Fatalf("Desktop had no provable pending skill write: %d %s", rec.Code, rec.Body)
+			}
+		})
+	}
+}
+
+func TestLibraryScopedRejectsAliasedOrRoutedWrites(t *testing.T) {
+	for _, scenario := range []string{"shared-antigravity", "mcp-router", "skill-router"} {
+		t.Run(scenario, func(t *testing.T) {
+			home, agy, desktop, state := scopedFixture(t)
+			source := filepath.Join(home, "fixture-source")
+			scopedWrite(t, filepath.Join(source, "SKILL.md"), "---\nname: fixture-skill\n---\nFixture\n")
+			kind := "servers/agents-all"
+			in := map[string]any{"agents": []string{"antigravity"}, "on": true}
+			wantReason := "requires direct per-agent delivery"
+			switch scenario {
+			case "shared-antigravity":
+				scopedWrite(t, filepath.Join(home, ".gemini", "antigravity-cli", "settings.json"), "{}")
+				scopedWrite(t, state, `{"mcp":[{"name":"fixture-server","transport":"stdio","command":"fixture-stdio","agents":["agy","antigravity"]}]}`)
+				wantReason = "shares its mcp destination"
+			case "mcp-router":
+				scopedWrite(t, state, `{"mcpHub":true}`)
+			case "skill-router":
+				scopedWrite(t, state, `{"skillRouter":true}`)
+				kind = "skills/install"
+				in = map[string]any{"agents": []string{"antigravity"}, "source": source, "paths": []string{""}}
+			}
+			beforeState, beforeAgy, beforeDesktop := scopedRead(t, state), scopedRead(t, agy), scopedRead(t, desktop)
+			b, err := json.Marshal(in)
+			if err != nil {
+				t.Fatal(err)
+			}
+			rec := scopedPost(scopedLibraryHandler(), "/api/library/scoped/"+kind, string(b))
+			if rec.Code == http.StatusOK || !strings.Contains(rec.Body.String(), wantReason) || !bytes.Equal(beforeState, scopedRead(t, state)) || !bytes.Equal(beforeAgy, scopedRead(t, agy)) || !bytes.Equal(beforeDesktop, scopedRead(t, desktop)) {
+				t.Fatalf("scope preflight failed to refuse before any write: %d %s", rec.Code, rec.Body)
+			}
+			if _, err := os.Stat(filepath.Join(filepath.Dir(state), "library", "skills", "fixture-skill")); !os.IsNotExist(err) {
+				t.Fatalf("rejected action created a skill: %v", err)
+			}
+		})
+	}
+}
