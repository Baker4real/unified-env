diff --git a/internal/library/scoped.go b/internal/library/scoped.go
new file mode 100644
index 0000000..2c0e25e
--- /dev/null
+++ b/internal/library/scoped.go
@@ -0,0 +1,196 @@
+package library
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+)
+
+// InstallFolderSkillsScoped adds local folder skills and applies those skills
+// only to the explicitly named targets. Remote installs can adopt existing
+// skills' sources and are served by the ordinary Library API.
+func InstallFolderSkillsScoped(source string, paths, agents []string) (*Result, error) {
+	if !filepath.IsAbs(source) || len(paths) == 0 {
+		return nil, errors.New("scoped install needs an absolute folder and skill paths")
+	}
+	p, err := ProbeSkills(source)
+	if err != nil {
+		return nil, err
+	}
+	in := &installed{}
+	res, err := changeScoped("skills", agents, func(l *Library) ([]string, error) {
+		if err := installFrom(l, p, paths, agents, true, in); err != nil {
+			return nil, err
+		}
+		if len(in.added)+len(in.had) == 0 && len(in.skipped) > 0 {
+			return nil, errors.New(in.skipped[0].Error)
+		}
+		return append(slices.Clone(in.added), in.had...), nil
+	})
+	if res != nil {
+		res.Installed, res.Had, res.Skipped = in.added, in.had, in.skipped
+	}
+	return res, err
+}
+
+// SetSkillAgentsScoped applies one skill only to the named agents. Taking
+// it away from an unlisted agent would change its desired state, so refuse
+// that request before saving.
+func SetSkillAgentsScoped(name string, agents []string) (*Result, error) {
+	if err := checkName("skill", name); err != nil {
+		return nil, err
+	}
+	return changeScoped("skills", agents, func(l *Library) ([]string, error) {
+		s := l.skill(name)
+		if s == nil {
+			return nil, fmt.Errorf("no skill called %s", name)
+		}
+		for _, id := range s.Agents {
+			if !slices.Contains(agents, id) {
+				return nil, fmt.Errorf("scoped skill assignment would remove unlisted agent %s", id)
+			}
+		}
+		s.Agents = slices.Clone(agents)
+		return []string{name}, nil
+	})
+}
+
+// SetServersAgentsScoped gives or takes the named servers for the selected
+// agents. Like the ordinary bulk operation, nil names means every server.
+func SetServersAgentsScoped(names, agents []string, on bool) (*Result, error) {
+	return changeScoped("mcp", agents, func(l *Library) ([]string, error) {
+		return nil, serverAgentChange(names, agents, on)(l)
+	})
+}
+
+// changeScoped runs one Library edit without the full reconciliation steps.
+// The complete target inventory is for detecting physical aliases and for
+// the skill writer's read-side decisions. Only the approved targets run
+// the writer for this kind. Applied entries for other targets are kept.
+func changeScoped(kind string, agents []string, edit func(*Library) ([]string, error)) (*Result, error) {
+	mu.Lock()
+	defer mu.Unlock()
+	l, err := load()
+	if err != nil {
+		return nil, err
+	}
+	if kind == "skills" && (l.SharedSkills || l.SkillRouter) || kind == "mcp" && l.MCPHub {
+		return nil, fmt.Errorf("scoped %s requires direct per-agent delivery", kind)
+	}
+	all := Targets()
+	known := append(slices.Clone(all), l.held(all)...)
+	selected, err := scopeTargets(kind, agents, known)
+	if err != nil {
+		return nil, err
+	}
+	names, err := edit(l)
+	if err != nil {
+		return nil, err
+	}
+	if err := l.save(); err != nil {
+		return nil, err
+	}
+	res := &Result{Changed: []string{}, Problems: []Problem{}}
+	b := newBackups()
+	for _, t := range selected {
+		switch {
+		case kind == "mcp":
+			l.syncMCP(t, b, res)
+		case len(names) == 0:
+			continue
+		case t.Desktop != nil:
+			l.syncDesktopSkills(t, res, names...)
+		default:
+			// A full sync can adopt user edits into the library and thereby
+			// change every linked reader's payload. Defer those to full sync.
+			var ready []string
+			for _, name := range names {
+				p := filepath.Join(t.Skills, name)
+				if made, ok := copiedAt(p); ok && !linked(p) {
+					at, err := changedAt(p)
+					if err == nil && at.After(made) && !sameTree(p, skillDir(name)) {
+						err = errors.New("skill copy was edited; reconcile it separately")
+					}
+					if err != nil {
+						res.fail(t.Agent.ID, "skill:"+name, err)
+						continue
+					}
+				}
+				ready = append(ready, name)
+			}
+			if len(ready) > 0 {
+				l.syncSkills(t, res, all, ready...)
+			}
+		}
+	}
+	res.Backup = b.dir
+	return res, l.save()
+}
+
+func scopeTargets(kind string, agents []string, known []*Target) ([]*Target, error) {
+	if len(agents) == 0 {
+		return nil, errors.New("scoped write needs at least one agent")
+	}
+	var selected []*Target
+	for i, id := range agents {
+		if slices.Contains(agents[:i], id) {
+			return nil, fmt.Errorf("duplicate scoped agent %q", id)
+		}
+		j := slices.IndexFunc(known, func(t *Target) bool { return t.Agent.ID == id && !t.Gone && t.Unreached == nil })
+		if j < 0 || len(scopePaths(known[j], kind)) == 0 || known[j].Agent.WSL != "" || known[j].Agent.ID == "liveagent" && kind == "skills" {
+			return nil, fmt.Errorf("no local %s target for scoped agent %q", kind, id)
+		}
+		selected = append(selected, known[j])
+	}
+	for _, target := range selected {
+		for _, path := range scopePaths(target, kind) {
+			// The shared skill root has readers even if none is registered
+			// in this Library. It has no private writer scope.
+			if kind == "skills" && sameScopePath(path, sharedSkillsDir()) {
+				return nil, fmt.Errorf("scoped agent %q writes the shared skills directory", target.Agent.ID)
+			}
+			for _, other := range known {
+				if slices.Contains(selected, other) {
+					continue
+				}
+				if slices.ContainsFunc(scopePaths(other, kind), func(p string) bool { return sameScopePath(path, p) }) ||
+					kind == "skills" && slices.Contains(other.SkillsAlso, target.Agent.ID) {
+					return nil, fmt.Errorf("scoped agent %q shares its %s destination with %q", target.Agent.ID, kind, other.Agent.ID)
+				}
+			}
+		}
+	}
+	return selected, nil
+}
+
+func scopePaths(t *Target, kind string) []string {
+	if kind == "mcp" {
+		if t.MCP != nil {
+			return t.MCP.files()
+		}
+		return nil
+	}
+	if t.Desktop != nil {
+		var paths []string
+		for _, root := range t.Desktop {
+			paths = append(paths, filepath.Join(root, "skills"), filepath.Join(root, desktopManifest))
+		}
+		return paths
+	}
+	if t.Skills != "" {
+		return []string{t.Skills}
+	}
+	return nil
+}
+
+func sameScopePath(a, b string) bool {
+	a, b = realBelow(a), realBelow(b)
+	if rel, err := filepath.Rel(a, b); err == nil && rel == "." {
+		return true
+	}
+	ai, ae := os.Stat(a)
+	bi, be := os.Stat(b)
+	return ae == nil && be == nil && os.SameFile(ai, bi)
+}
